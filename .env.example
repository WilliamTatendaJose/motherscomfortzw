# Copy to .env.local for development, and set the same values in
# Vercel → Project Settings → Environment Variables for production.
#
# The site builds and runs with NONE of these set — it falls back to the
# content in src/content and hides the online donation form. Fill them in as
# each service is set up.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Public URL, no trailing slash. Used for canonical URLs, the sitemap, and the
# Paynow return/result URLs.
NEXT_PUBLIC_SITE_URL=https://motherscomfort.co.zw

# ---------------------------------------------------------------------------
# Sanity — content
# Create a project at https://sanity.io/manage, then run:
#   npx sanity dataset create production
#   npx sanity dataset create donations --visibility private
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01
NEXT_PUBLIC_SANITY_DONATIONS_DATASET=donations

# Viewer token, for draft-mode previews from the Studio.
SANITY_API_READ_TOKEN=

# Editor token. Used to write donations and form submissions, and by `npm run seed`.
# Server-side only — never prefix this with NEXT_PUBLIC_.
SANITY_WRITE_TOKEN=
SANITY_DONATIONS_DATASET=donations

# Shared secret for the Sanity webhook that revalidates the cache.
# Sanity Manage → API → Webhooks → point at https://<site>/api/revalidate
SANITY_REVALIDATE_SECRET=

# ---------------------------------------------------------------------------
# Paynow — https://www.paynow.co.zw (Merchant portal → Integrations)
# Paynow issues a separate ID/key per currency; these are the USD pair.
# Express Checkout (in-page EcoCash/OneMoney/InnBucks) must be enabled on the
# account separately — without it, only the redirect flow will work.
# ---------------------------------------------------------------------------
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=

# Donors are not required to give an email, but Paynow's Express Checkout
# rejects a transaction without a valid `authemail`. When a donor gives no
# address this one is sent instead, so the payment still goes through and the
# receipt reaches the charity. Defaults to CONTACT_NOTIFY_EMAIL if unset.
# This is also the address Paynow's test mode expects.
PAYNOW_FALLBACK_EMAIL=info@motherscomfort.co.zw

# Optional overrides. Default to NEXT_PUBLIC_SITE_URL + the standard paths.
# PAYNOW_RESULT_URL must be publicly reachable — Paynow calls it server-to-server,
# so localhost will never receive it. Use a tunnel when testing locally:
#   cloudflared tunnel --url http://localhost:3000
# PAYNOW_RESULT_URL=https://<tunnel>/api/paynow/result
# PAYNOW_RETURN_URL=

# ---------------------------------------------------------------------------
# Email — https://resend.com
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Mother's Comfort <noreply@motherscomfort.co.zw>"
CONTACT_NOTIFY_EMAIL=info@motherscomfort.co.zw
